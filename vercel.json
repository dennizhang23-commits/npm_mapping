{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm run install:all",
  "rewrites": [
    {
      "source": "/",
      "destination": "/docs-site/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/docs-site/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}